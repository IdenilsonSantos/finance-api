DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
JWT_SECRET=substitua-por-uma-chave-segura
JWT_EXPIRES_IN=1d
PORT=3001
ADMIN_JWT_SECRET=local-admin-jwt-secret
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=substitua-por-uma-chave-segura

# Fuso usado para "hoje" em agendamentos e ajustes (padrão: America/Sao_Paulo)
APP_TIMEZONE=America/Sao_Paulo

# Número de proxies na frente da API (ex.: 1 no Render/Railway). Necessário para o rate limit usar o IP real.
# TRUST_PROXY=1
